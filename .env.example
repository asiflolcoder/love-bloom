# Copy this file to .env and fill in your own values

# The date the "streak" starts counting from (YYYY-MM-DD).
# Could be the day you started this app, your anniversary, or your first date.
START_DATE=2026-08-20

# Her display name (used in the greeting)
PARTNER_NAME=KiMi

# A secret passphrase YOU use to open the private admin page at /admin
# where you can write today's message, add memories, etc.
# Make this something only you know.
ADMIN_SECRET=i_am_a_cow

# Port the server runs on
PORT=3000

# Optional: web push notifications (advanced, can be skipped at first)
# Generate a keypair by running: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Optional: hour (0-23, server local time) to auto-send the daily push notification
DAILY_NOTIFY_HOUR=9
